#!/usr/bin/env zsh
cd "$(dirname "$0")"

if [ ! -d node_modules ]; then
  echo "Installing dependencies..."
  npm install
fi

echo "Starting Curiosity server on http://localhost:3456"
node server.js &
echo $! > .server.pid
echo "Server PID: $(cat .server.pid)"
echo "Open http://localhost:3456 in your browser"
