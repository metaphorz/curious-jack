#!/usr/bin/env zsh
cd "$(dirname "$0")"

if [ -f .server.pid ]; then
  PID=$(cat .server.pid)
  if kill -0 "$PID" 2>/dev/null; then
    kill "$PID"
    echo "Stopped Curiosity server (PID $PID)"
  else
    echo "Server was not running"
  fi
  rm .server.pid
else
  echo "No PID file found — server may not be running"
fi
